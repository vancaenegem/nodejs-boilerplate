{
  "name": "boilerplate",
  "keywords": [],
  "description": "A boilerplate for NodeJS",
  "author": {
    "name": "Stephane VAN CAENEGEM",
    "email": "stephane@vancaenegem.fr",
    "url": "http://vancaenegem.fr/"
  },
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start_daemon": "node index.js",
    "start": "electron .",
    "build": "electron-builder",
    "package": "npx electron-packager . --overwrite --asar=true"
  },
  "bin": "index.js",
    "dependencies": {
    "bytenode": "^2.1.0",
    "chokidar": "^6.0.0",
    "cors": "^2.8.6",
    "cron": "^4.4.0",
    "express": "^5.3.0",
    "socket.io": "^4.8.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tx2": "^1.0.5",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "electron": "^45.3.3"
  },
  "build": {
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "runAfterFinish": false
    }
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "config/**/*",
      "app/**/*",
      "node_modules/socket.io/client-dist/*.js",
      "node_modules/swagger-ui-dist/**/*"
    ],
    "targets": [
      "node16-win-x64"
    ],
    "outputPath": "dist"
  }
}
